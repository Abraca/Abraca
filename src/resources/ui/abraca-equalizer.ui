  <template class="AbracaEqualizer" parent="GtkDialog">
    <property name="width_request">400</property>
    <property name="height_request">300</property>
    <property name="title">Equalizer</property>
    <child internal-child="headerbar">
      <object class="GtkHeaderBar" id="dialog-header_bar">
        <child>
          <object class="GtkComboBox" id="combobox_bands">
            <property name="model">liststore_bands</property>
            <property name="id_column">1</property>
            <signal name="changed" handler="on_combobox_changed" swapped="no" />
            <child>
              <object class="GtkCellRendererText" id="cellrenderertext1" />
              <attributes>
                <attribute name="text">0</attribute>
              </attributes>
            </child>
          </object>
        </child>
        <child>
