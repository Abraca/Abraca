                        <property name="focusable">1</property>
                        <property name="vexpand">1</property>
                        <property name="orientation">vertical</property>
                        <property name="adjustment">adjustment_volume</property>
                        <property name="inverted">1</property>
                        <property name="round_digits">1</property>
                        <signal name="value-changed" handler="on_volume_changed" swapped="no" />
                      <layout>
                      <property name="column">0</property>
                      <property name="row">0</property>
                    </layout>
                  </object>
                    </child>
                <child>
                  <object class="GtkLabel" id="label_volume">
                        <property name="label" translatable="1">Volume</property>
                      <layout>
                      <property name="column">0</property>
                      <property name="row">1</property>
                    </layout>
                  </object>
                    </child>
                <child>
