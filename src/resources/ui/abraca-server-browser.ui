<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkSizeGroup">
    <widgets>
      <widget name="cancel_button"/>
      <widget name="connect_button"/>
    </widgets>
  </object>
  <object class="GtkListStore" id="location_store">
    <columns>
      <column type="gchararray"/>
      <column type="gchararray"/>
    </columns>
  </object>
  <template class="AbracaServerBrowserDialog" parent="GtkDialog">
    <property name="width_request">400</property>
    <property name="height_request">300</property>
    <property name="title" translatable="1">Discovered Players</property>
    <property name="modal">1</property>
    <property name="destroy_with_parent">1</property>
    <child internal-child="headerbar">
      <object class="GtkHeaderBar" id="dialog-header_bar">
        <property name="show-title-buttons">0</property>
        <child>
          <object class="GtkButton" id="cancel_button">
            <property name="label" translatable="1">_Cancel</property>
            <property name="focusable">1</property>
            <property name="use_underline">1</property>
            <property name="valign">center</property>
            <signal name="clicked" handler="on_cancel_clicked" swapped="no"/>
            <style>
              <class name="text-button"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="connect_button">
            <property name="label" translatable="1">C_onnect</property>
            <property name="sensitive">0</property>
            <property name="focusable">1</property>
            <property name="use_underline">1</property>
            <signal name="clicked" handler="on_connect_clicked" swapped="no"/>
            <style>
              <class name="text-button"/>
              <class name="suggested-action"/>
            </style>
          </object>
        </child>
      </object>
    </child>
    <child internal-child="content_area">
      <object class="GtkBox" id="dialog-vbox1">
        <property name="orientation">vertical</property>
        <property name="spacing">2</property>
        <child>
          <object class="GtkBox" id="box1">
            <property name="vexpand">1</property>
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkScrolledWindow" id="scrolledwindow1">
                <property name="vexpand">1</property>
                <property name="height_request">100</property>
                <property name="focusable">1</property>
                <property name="hscrollbar_policy">never</property>
                <property name="child">
                  <object class="GtkTreeView" id="location_tree">
                    <property name="height_request">300</property>
                    <property name="focusable">1</property>
                    <property name="has_tooltip">1</property>
                    <property name="model">location_store</property>
                    <property name="headers_visible">0</property>
                    <property name="headers_clickable">0</property>
                    <property name="enable_search">0</property>
                    <property name="search_column">0</property>
                    <property name="tooltip_column">0</property>
                    <signal name="row-activated" handler="on_location_row_activated" swapped="no"/>
                    <child internal-child="selection">
                      <object class="GtkTreeSelection" id="location_selection">
                        <signal name="changed" handler="on_location_row_selected" swapped="no"/>
                      </object>
                    </child>
                    <child>
                      <object class="GtkTreeViewColumn" id="treeviewcolumn1">
                        <property name="title" translatable="1">Name</property>
                        <child>
                          <object class="GtkCellRendererText" id="cellrenderertext1"/>
                          <attributes>
                            <attribute name="text">0</attribute>
                          </attributes>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkExpander" id="expander">
                <property name="focusable">1</property>
                <property name="resize_toplevel">1</property>
                <child>
                  <object class="GtkBox" id="box3">
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="GtkLabel" id="label3">
                        <property name="halign">start</property>
                        <property name="label" translatable="1">Location:</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="location_entry">
                        <property name="focusable">1</property>
                        <property name="invisible_char">●</property>
                        <signal name="activate" handler="on_location_entry_activated" swapped="no"/>
                        <signal name="changed" handler="on_location_entry_changed" swapped="no"/>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="button3">
                        <property name="valign">center</property>
                        <property name="label" translatable="1">_Start a local player</property>
                        <property name="focusable">1</property>
                        <property name="halign">start</property>
                        <property name="use_underline">1</property>
                        <signal name="clicked" handler="on_launch_clicked" swapped="no"/>
                      </object>
                    </child>
                  </object>
                </child>
                <child type="label">
                  <object class="GtkLabel" id="label1">
                    <property name="halign">start</property>
                    <property name="label" translatable="1">Advanced</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <action-widgets>
      <action-widget response="-6">cancel_button</action-widget>
      <action-widget response="-5">connect_button</action-widget>
    </action-widgets>
  </template>
</interface>
